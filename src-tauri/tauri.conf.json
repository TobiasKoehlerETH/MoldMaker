{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoldMaker",
  "version": "0.1.0",
  "identifier": "com.moldmaker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "MoldMaker",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1420; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["../assets/icon.ico", "../assets/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NDg4RDc3RDU2RDNGNzgKUldSNFAyM1ZkNDFJTmZZa3hUM3R5eTVxV1JOeVJiSzNoTzl1eklQU01IZUxXRXNQeW5kYk1HV1YK",
      "endpoints": [
        "https://github.com/TobiasKoehlerETH/MoldMaker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
