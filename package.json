{
  "name": "moldmaker",
  "version": "0.1.0",
  "private": true,
  "description": "Offline STEP-to-RTV silicone mold generator",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1",
    "tauri": "tauri",
    "preview": "vite preview --host 127.0.0.1",
    "preview:agent": "npm run build:frontend && vite preview --host 127.0.0.1",
    "build": "npm run build:frontend",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src/renderer src/shared tests scripts vite.config.ts vitest.config.ts eslint.config.mjs --max-warnings 0",
    "test": "vitest run",
    "codegraph": "node scripts/generate-code-graph.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dist:win": "npm run check && tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.468.0",
    "madge": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "replicad": "^1.0.1",
    "replicad-opencascadejs": "^1.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  }
}
